# ───────────────────────────────────────────────────────────────────────────
# STANNUM Game — Frontend (Next.js)
# Copiá este archivo a `.env.local` y completá los valores.
#   cp .env.example .env.local
# Las variables NEXT_PUBLIC_* se exponen al navegador (no pongas secretos ahí).
# ───────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_MAINTENANCE_MODE=false
# Opcionales (tienen fallback en el código: 'unknown' y '' respectivamente)
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_APP_ORIGIN=

# ── API base ─────────────────────────────────────────────────────────────────
# Base de la API del backend (stannum-game-backend-v2). En prod apuntá al deploy.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Sub-paths por recurso (se concatenan a NEXT_PUBLIC_API_URL). Valores reales:
NEXT_PUBLIC_API_AUTH_URL=/auth
NEXT_PUBLIC_API_USER_URL=/user
NEXT_PUBLIC_API_PHOTO_URL=/profile-photo
NEXT_PUBLIC_API_LESSON_URL=/lesson
NEXT_PUBLIC_API_INSTRUCTION_URL=/instruction
NEXT_PUBLIC_API_PRODUCT_KEY_URL=/product-key
NEXT_PUBLIC_API_RANKING_URL=/ranking
NEXT_PUBLIC_API_PROMPT_URL=/prompt
NEXT_PUBLIC_API_ASSISTANT_URL=/assistant
NEXT_PUBLIC_API_STORE_URL=/store
NEXT_PUBLIC_API_CHEST_URL=/chest
NEXT_PUBLIC_API_PAYMENT_URL=/payment
NEXT_PUBLIC_API_SUBSCRIPTION_URL=/subscription
# Entrenador IA (STAN). Opcional: si falta, el código usa '/trainer' por defecto.
NEXT_PUBLIC_API_TRAINER_URL=/trainer

# ── Integraciones ────────────────────────────────────────────────────────────
# Google Identity (login con Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# reCAPTCHA v2/v3 site key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# Mux: token de datos público (NEXT_PUBLIC) + mapa de playback IDs por lección (JSON)
NEXT_PUBLIC_MUX_TOKEN_DATA=your-mux-data-token
NEXT_PUBLIC_MUX_IDS={"WELCOME":"...","TIAM01L01":"..."}

# ── Server-only (NO NEXT_PUBLIC: solo se usa en Server Components) ────────────
# API key para que los Server Components consulten el backend (= MAKE_API_KEY del backend)
STANNUM_API_KEY=your-server-api-key
